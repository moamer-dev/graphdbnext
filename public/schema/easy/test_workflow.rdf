    <rdfs:domain rdf:resource="https://graphdbnext.example.com/schema/Surface" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </rdf:Property>

  <rdf:Property rdf:about="https://graphdbnext.example.com/schema/Column_id">
    <rdfs:label>id</rdfs:label>
    <rdfs:domain rdf:resource="https://graphdbnext.example.com/schema/Column" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Property>

  <rdf:Property rdf:about="https://graphdbnext.example.com/schema/Column_n">
    <rdfs:label>n</rdfs:label>
    <rdfs:domain rdf:resource="https://graphdbnext.example.com/schema/Column" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </rdf:Property>

  <rdf:Property rdf:about="https://graphdbnext.example.com/schema/Line_id">
    <rdfs:label>id</rdfs:label>
    <rdfs:domain rdf:resource="https://graphdbnext.example.com/schema/Line" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Property>

  <rdf:Property rdf:about="https://graphdbnext.example.com/schema/Line_n">
    <rdfs:label>n</rdfs:label>
    <rdfs:domain rdf:resource="https://graphdbnext.example.com/schema/Line" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </rdf:Property>

  <rdf:Property rdf:about="https://graphdbnext.example.com/schema/Seg_id">
    <rdfs:label>id</rdfs:label>
    <rdfs:domain rdf:resource="https://graphdbnext.example.com/schema/Seg" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Property>

  <rdf:Property rdf:about="https://graphdbnext.example.com/schema/Seg_type">
    <rdfs:label>type</rdfs:label>
    <rdfs:domain rdf:resource="https://graphdbnext.example.com/schema/Seg" />
